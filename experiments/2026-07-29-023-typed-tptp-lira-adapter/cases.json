{
  "schema_version": 1,
  "accepted": [
    {
      "name": "existential_integer_negative_floor",
      "source": "tff(case,axiom,? [I:$int] : (I = $to_int(-1.5)))."
    },
    {
      "name": "universal_integer_guard",
      "source": "tff(case,axiom,! [I:$int] : ($floor($to_real(I)) = $to_real(I)))."
    },
    {
      "name": "real_floor_shift",
      "source": "tff(case,axiom,! [R:$real] : ($floor($sum(R,1.0)) = $sum($floor(R),1.0)))."
    },
    {
      "name": "negative_ceiling",
      "source": "tff(case,axiom,$ceiling(-1.5) = -1.0)."
    },
    {
      "name": "ground_rational_comparison",
      "source": "tff(case,axiom,$less(1/3,1/2))."
    },
    {
      "name": "integer_quotient_embedding",
      "source": "tff(case,axiom,! [I:$int] : ($to_real($quotient(I,2)) = $quotient($to_real(I),2.0)))."
    },
    {
      "name": "explicit_mixed_sort_coercion",
      "source": "tff(case,axiom,! [I:$int,R:$real] : (($to_real(I) = R) => ($sum($to_real(I),R) = $product(2.0,R))))."
    },
    {
      "name": "real_is_integer",
      "source": "tff(case,axiom,! [R:$real] : ($is_int(R) <=> ($floor(R) = R)))."
    },
    {
      "name": "scalar_product",
      "source": "tff(case,axiom,! [R:$real] : ($product(3.0,R) = $sum(R,$sum(R,R))))."
    },
    {
      "name": "comparison_partition",
      "source": "tff(case,axiom,! [R:$real] : ($less(R,0.0) | $greatereq(R,0.0)))."
    },
    {
      "name": "integer_to_rat_to_real",
      "source": "tff(case,axiom,! [I:$int] : ($to_real($to_rat(I)) = $to_real(I)))."
    },
    {
      "name": "exponent_literal_difference",
      "source": "tff(case,axiom,$difference(1.25E2,25.0) = 100.0)."
    }
  ],
