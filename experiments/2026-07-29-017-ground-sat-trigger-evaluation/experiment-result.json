  "decision": {
    "outcome": "stop",
    "rule": "Promote only a correctness-passing trigger with at least eight reached coordinates across four problems, no lost solve, and either a unique solve or common-solve CPU at most 0.95 with the preregistered size, memory, and SAT-cost guards.",
    "reasons": [
      "All candidates preserved the five-solve baseline but added no solve.",
      "The dominant generated-schedule policy, step5000, reached the minimum eight coordinates cheaply but had a 1.001514 common-solve CPU ratio rather than the required 0.95.",
      "step10000 reached only two coordinates on one problem.",
      "size10000 made 656 calls, spent 55.8% of reached-run CPU inside SATCheck, regressed common-solve CPU to 1.542813, and regressed RSS to 1.132813."
    ],
    "production_effect": "Leave periodic ground-SAT checking default-off; reject the size-10000 trigger and do not promote either processed-step trigger."
  }
